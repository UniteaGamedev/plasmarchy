[Unit]
Description=Plasmarchy wake word (local; starts a conversation with the AI assistant)
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
ExecStart=%h/.local/share/plasmarchy/voice/wakeenv/bin/python %h/.local/share/plasmarchy/lib/wake.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
