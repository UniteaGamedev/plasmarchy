#version 440
// Colors the animated ASCII logo: a gradient across the logo with a wave running through it.
// The characters are drawn white; green = 0 marks characters still being swept in (drawn in the text color).
layout(location = 0) in vec2 qt_TexCoord0;
layout(location = 0) out vec4 fragColor;
layout(std140, binding = 0) uniform buf {
    mat4 qt_Matrix;
    float qt_Opacity;
    vec2 size;
    vec2 origin;      // top left of the logo
    vec2 cellSize;
    float cols;
    float shimmer;
    vec4 fg;
    vec4 accent;
    vec4 c0;
    vec4 c1;
    vec4 c2;
    vec4 c3;
};
layout(binding = 1) uniform sampler2D source;

void main() {
    vec4 s = texture(source, qt_TexCoord0);
    if (s.a < 0.004) { fragColor = vec4(0.0); return; }
    vec2 cell = floor((qt_TexCoord0 * size - origin) / cellSize);
    float g = fract(max(cell.x, 0.0) / cols + shimmer);
    float i = floor(g * 4.0);
    vec3 base = i < 0.5 ? c0.rgb : i < 1.5 ? c1.rgb : i < 2.5 ? c2.rgb : c3.rgb;
    float t = 0.35 + 0.25 * sin((g + cell.y * 0.05) * 6.2831853);
    vec3 col = mix(base, accent.rgb, t);
    col = mix(fg.rgb, col, clamp(s.g / s.a, 0.0, 1.0));
    fragColor = vec4(col, 1.0) * s.a * qt_Opacity;
}
