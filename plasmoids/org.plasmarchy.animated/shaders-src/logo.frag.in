#version 440
// Colors the animated ASCII logo: a gradient across the logo with a wave running through it.
layout(location = 0) in vec2 vUV;
layout(location = 1) in vec2 vCell;
layout(location = 2) in float vAlpha;
layout(location = 3) in float vNoise;
layout(location = 4) in float vText;
layout(location = 0) out vec4 fragColor;

#include "logo_block.glsl"
layout(binding = 1) uniform sampler2D glyphs;   // the logo's characters, one slot per cell
layout(binding = 2) uniform sampler2D noiseGlyphs;   // random characters for "decrypt"
layout(binding = 3) uniform sampler2D occupied;      // one pixel per cell: is there a character?

void main() {
    float a = vNoise >= 0.0 ? texture(noiseGlyphs, vec2((vNoise + vUV.x) / noiseCount, vUV.y)).a
                              * texture(occupied, (vCell + 0.5) / vec2(cols, rows)).a
                            : texture(glyphs, (vCell + vUV) / vec2(cols, rows)).a;
    a *= vAlpha;
    if (a < 0.004) { fragColor = vec4(0.0); return; }
    float g = fract(vCell.x / cols + shimmer);
    float i = floor(g * 4.0);
    vec3 base = i < 0.5 ? c0.rgb : i < 1.5 ? c1.rgb : i < 2.5 ? c2.rgb : c3.rgb;
    vec3 col = mix(base, accent.rgb, 0.35 + 0.25 * sin((g + vCell.y * 0.05) * 6.2831853));
    if (vText > 0.5) col = fg.rgb;
    fragColor = vec4(col, 1.0) * a * qt_Opacity;
}
